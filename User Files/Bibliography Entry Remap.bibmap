<?xml version="1.0" encoding="us-ascii"?>
<bibliographyentryremapping xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<maps>
		<item key="proceedings">
			<value name="Proceedings to InProceedings" totype="inproceedings">
				<fieldmaps>
					<fieldmap from="series" to="booktitle"/>
					<fieldmap from="eprint" to="href"/>
				</fieldmaps>
			</value>
		</item>
		<item key="article">
			<value name="Article" totype="article">
				<fieldmaps>
					<fieldmap from="publisher" to="organization"/>
				</fieldmaps>
			</value>
		</item>
	</maps>
</bibliographyentryremapping>