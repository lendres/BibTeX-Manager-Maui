<?xml version="1.0" encoding="utf-8" ?>
<dpviews:PopupView
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:system="clr-namespace:System;assembly=mscorlib"
	xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	xmlns:dpviews="clr-namespace:DigitalProduction.Maui.Views;assembly=DigitalProduction.Maui.AppToolkit"
	xmlns:viewModels="clr-namespace:BibTeXManager.ViewModels"
	x:DataType="viewModels:GetNameViewModel"
	x:Class="BibTeXManager.Views.GetNameView"
	CanBeDismissedByTappingOutsideOfPopup="False">

	<Border StyleClass="PopupFrameStyle" MinimumWidthRequest="570" MinimumHeightRequest="380">

		<VerticalStackLayout StyleClass="VerticalLayoutStyle">
			<Label Text="{Binding Title}" StyleClass="Title"  HorizontalOptions="Start"/>

			<Grid RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="Auto,*"
				RowSpacing="10" ColumnSpacing="10" Padding="20" WidthRequest="700" HeightRequest="500">

				<VerticalStackLayout StyleClass="TitleVerticalStackStyle">
					<Label Text="Name" StyleClass="ControlLabel"/>
					<Entry
						x:Name="_bibliographyEntryMapNameEntry"
						Placeholder="Name"
						Text="{Binding Name.Value}"
						HorizontalOptions="Fill">
						<Entry.Behaviors>
							<mct:EventToCommandBehavior
								x:TypeArguments="system:EventArgs"
								Command="{Binding ValidateNameCommand}"
								BindingContext="{Binding Path=BindingContext, Source={x:Reference _bibliographyEntryMapNameEntry}, x:DataType=Entry}"
								EventName="TextChanged"/>
						</Entry.Behaviors>
					</Entry>
					<Label Text="{Binding Name.Errors, Converter={StaticResource FirstValidationErrorConverter}}" StyleClass="InvalidLabelStyle"/>
				</VerticalStackLayout>
				
			</Grid>

			<HorizontalStackLayout StyleClass="BottomButtonRowStyle">
				<Button 
						Text="OK"
						HorizontalOptions="End"
						StyleClass="StandardSizeButtonStyle"
						IsEnabled="{Binding IsSubmittable}"
						Clicked="OnSaveButtonClicked"/>
				<Button 
						Text="Cancel"
						StyleClass="StandardSizeButtonStyle"
						HorizontalOptions="End"
						Clicked="OnCancelButtonClicked"/>
			</HorizontalStackLayout>
		</VerticalStackLayout>
	</Border>
</dpviews:PopupView>