<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:views="clr-namespace:BibTeXManager.Views"
	xmlns:viewmodel="clr-namespace:BibTeXManager.ViewModels"
	x:DataType="viewmodel:StringReplacementFieldProcessorViewModel"
    x:Class="BibTeXManager.Views.StringReplacementFieldProcessorView">

	<Grid RowDefinitions="Auto,Auto,*" Margin="0" Padding="30" WidthRequest="850" VerticalOptions="Fill">
		<views:FieldProcessorHeaderView 
			Grid.Row="0"
			x:Name="_fieldProcessorHeaderView"/>

		<VerticalStackLayout Grid.Row="1" StyleClass="TitleVerticalStackStyle">
			<Label Text="Replacement" StyleClass="ControlLabel"/>
			<Entry
				x:Name="_replacementEntry"
				Placeholder="Replacement"
				Text="{Binding Replacement}"
				TextChanged="OnTextChanged"/>
		</VerticalStackLayout>

		<views:FieldProcessorFieldsView 
			Grid.Row="2"
			x:Name="_fieldProcessorFieldsView"/>

	</Grid>
</ContentPage>