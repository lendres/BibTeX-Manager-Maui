<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:viewmodel="clr-namespace:BibTeXManager.ViewModels"
	x:DataType="viewmodel:FieldProcessorGroupEditorViewModel"
    x:Class="BibTeXManager.Views.FieldProcessorGroupEditorView">

	<Shell.BackButtonBehavior>
		<BackButtonBehavior IsVisible="False" IsEnabled="False" />
	</Shell.BackButtonBehavior>

	<Grid RowDefinitions="Auto,Auto,*" Margin="0" Padding="30" WidthRequest="850" VerticalOptions="Fill">

		<Grid Grid.Row="0" ColumnDefinitions="*,400" HorizontalOptions="Fill">
			<Label Grid.Column="0" Text="Field Processor Group" StyleClass="Title" HorizontalOptions="Start" VerticalOptions="Center" />
			<HorizontalStackLayout Grid.Column="1" StyleClass="BottomButtonRowStyle">
				<Button Text="Save &amp; Return" StyleClass="StandardSizeButtonStyle" Clicked="OnSaveAndReturn" HorizontalOptions="End" IsEnabled="{Binding IsSubmittable}"/>
				<Button Text="Save" StyleClass="StandardSizeButtonStyle" Clicked="OnSave" HorizontalOptions="End" IsEnabled="{Binding IsSubmittable}"/>
				<Button Text="Cancel" StyleClass="StandardSizeButtonStyle" Clicked="OnCancel" HorizontalOptions="End"/>
			</HorizontalStackLayout>
		</Grid>

		<VerticalStackLayout Grid.Row="1" Spacing="8">
			<Label Text="Group Name" />
			<Entry Text="{Binding FieldProcessorGroup.Name}" />
		</VerticalStackLayout>

		<Grid Grid.Row="2" ColumnDefinitions="*,2*" ColumnSpacing="12">

			<VerticalStackLayout Grid.Column="0" Spacing="8">
				<Label Text="Processors" FontAttributes="Bold" />

				<CollectionView
                    ItemsSource="{Binding Processors}"
                    SelectedItem="{Binding SelectedProcessor}"
                    SelectionMode="Single">

					<CollectionView.ItemTemplate>
						<DataTemplate>
							<Grid Padding="6" RowDefinitions="Auto,Auto">
								<Label Text="{Binding Pattern}" FontAttributes="Bold" />
								<Label Grid.Row="1" Text="{Binding Replacement}" FontSize="12" />
							</Grid>
						</DataTemplate>
					</CollectionView.ItemTemplate>
				</CollectionView>

				<HorizontalStackLayout Spacing="8">
					<Button Text="Add" Command="{Binding AddProcessorCommand}" />
					<Button Text="Delete" Command="{Binding DeleteProcessorCommand}" />
				</HorizontalStackLayout>
			</VerticalStackLayout>

			<ScrollView Grid.Column="1">
				<VerticalStackLayout Spacing="10" BindingContext="{Binding SelectedProcessor}">

					<Label Text="Selected Processor" FontAttributes="Bold" />

					<Label Text="Fields To Process" />
					<Picker
                        ItemsSource="{Binding FieldstoprocessOptions}"
                        SelectedItem="{Binding Fieldstoprocess}" />

					<Label Text="Pattern" />
					<Entry Text="{Binding Pattern}" />

					<Label Text="Replacement" />
					<Entry Text="{Binding Replacement}" />

					<Label Text="Fields" FontAttributes="Bold" />

					<CollectionView ItemsSource="{Binding Fields}">
						<CollectionView.ItemTemplate>
							<DataTemplate>
								<Grid ColumnDefinitions="*,Auto" Padding="0,4">
									<Entry Text="{Binding .}" />
									<Button
                                        Grid.Column="1"
                                        Text="Delete"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteFieldCommand}"
                                        CommandParameter="{Binding .}" />
								</Grid>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>

					<Button
                        Text="Add Field"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddFieldCommand}" />
				</VerticalStackLayout>
			</ScrollView>
		</Grid>

	</Grid>
</ContentPage>