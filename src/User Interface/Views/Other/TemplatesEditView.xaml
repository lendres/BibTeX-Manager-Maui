<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:system="clr-namespace:System;assembly=mscorlib"
	xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	xmlns:dpviews="clr-namespace:DigitalProduction.Maui.Views;assembly=DigitalProduction.Maui.AppToolkit"
	xmlns:dpconverters="clr-namespace:DigitalProduction.Maui.Converters;assembly=DigitalProduction.Maui.AppToolkit"
	xmlns:dg="clr-namespace:Maui.DataGrid;assembly=Maui.DataGrid"
	xmlns:enums="clr-namespace:BibTeXManager.Enums"
	xmlns:viewmodel="clr-namespace:BibTeXManager.ViewModels"
	xmlns:dpcontrols="clr-namespace:DigitalProduction.Maui.Controls;assembly=DigitalProduction.Maui"
	xmlns:library="clr-namespace:BibTeXLibrary;assembly=DigitalProduction.BibTeXLibrary"
	x:DataType="viewmodel:TemplatesEditViewModel"
	x:Class="BibTeXManager.Views.TemplatesEditView">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
		<mct:EnumToIntConverter x:Key="EnumToIntConverter"/>
		<mct:IsNotNullConverter x:Key="IsNotNullConverter"/>
		<dpconverters:FirstValidationErrorConverter x:Key="FirstValidationErrorConverter"/>
		<dpconverters:EnumToStringConverter x:Key="PartTypeEnumToStringConverter" x:TypeArguments="enums:InitializationPartType"/>
		<dpconverters:SingleEnumToBoolConverter x:Key="PartView" x:TypeArguments="enums:InitializationPartType"/>
	</ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="0" Padding="30" WidthRequest="850" VerticalOptions="Fill">
		
        <!-- Settings label, save, and cancel buttons. -->
        <Grid Grid.Row="0" RowDefinitions="Auto" ColumnDefinitions="*,250" HorizontalOptions="Fill" VerticalOptions="Start">
            <Label Grid.Column="0" Text="Bibliography Entry Templates" StyleClass="Title" HorizontalOptions="Start" VerticalOptions="Center"/>
            <HorizontalStackLayout Grid.Column="1" StyleClass="BottomButtonRowStyle" Padding="0,0,0,0" VerticalOptions="Center">
                <Button 
				    Text="OK"
				    HorizontalOptions="End"
				    StyleClass="StandardSizeButtonStyle"
				    IsEnabled="{Binding IsSubmittable}"
                    VerticalOptions="Center"
				    Clicked="OnSave"/>
                <Button 
				    Text="Cancel"
				    StyleClass="StandardSizeButtonStyle"
				    HorizontalOptions="End"
				    Clicked="OnCancel"/>
            </HorizontalStackLayout>
        </Grid>

		<!-- Selector. -->
		<Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,*" Padding="0"  Margin="0,30,0,0"
			RadioButtonGroup.GroupName="PartSelectorGroup"
			RadioButtonGroup.SelectedValue="{Binding ActiveInitializationPart, Converter={StaticResource PartTypeEnumToStringConverter}}"
			VerticalOptions="Center" HorizontalOptions="Fill">
			<Grid.Resources>
				<Style TargetType="RadioButton">
					<Setter Property="ControlTemplate" Value="{StaticResource ButtonRadioTemplate}"/>
					<Setter Property="HorizontalOptions" Value="Fill"/>
					<Setter Property="FontSize" Value="20"/>
				</Style>
			</Grid.Resources>
			<RadioButton Grid.Column="0" Content="Types" Value="TypeMaps"/>
			<RadioButton Grid.Column="1" Content="Templates" Value="Templates"/>
		</Grid>



		<Grid Grid.Row="2" StyleClass="DataGridEditStyle" Margin="0,0,20,0" Padding="0,0,20,0"
			IsVisible="{Binding ActiveInitializationPart, Converter={StaticResource PartView}, ConverterParameter={x:Static enums:InitializationPartType.TypeMaps}}">
			<HorizontalStackLayout Grid.Row="0" Grid.Column="0" StyleClass="TopButtonRowStyle">
				<Button Text="Add" Clicked="OnNewNameMap" StyleClass="SquareButtonStyle"/>
				<Button Text="Edit" Clicked="OnEditNameMap" StyleClass="SquareButtonStyle"
				IsEnabled="{Binding SelectedItem, Converter={StaticResource IsNotNullConverter}}"/>
				<Button Text="Delete" Clicked="OnDeleteNameMap" StyleClass="SquareButton"
				IsEnabled="{Binding SelectedItem, Converter={StaticResource IsNotNullConverter}}"/>
			</HorizontalStackLayout>

			<dg:DataGrid
			Grid.Row="1"
			x:Name="_dataGrid"
			Style="{DynamicResource DataGridDefaultLooseStyle}"
			ItemsSource="{Binding Items, Mode=TwoWay}" SelectionMode="{Binding SelectionMode}"
			SelectedItem="{Binding SelectedItem}" RowToEdit="{Binding ItemToEdit}"
			RefreshingEnabled="true" PullToRefreshCommand="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}"
			PaginationEnabled="false"
			RowTappedCommand="{Binding TappedCommand}"
			IsEnabled="{Binding Items, Converter={StaticResource IsNotNullConverter}}">

				<dg:DataGrid.Columns>
					<dg:DataGridColumn Title="From Name" PropertyName="From" Width="0.5*"
						CellTemplate="{StaticResource DataGridDefaultStringCellTempate}"/>
					<dg:DataGridColumn Title="To Name" PropertyName="To" Width="0.5*"
						CellTemplate="{StaticResource DataGridDefaultStringCellTempate}"/>
				</dg:DataGrid.Columns>
			</dg:DataGrid>
		</Grid>

		<!-- Top padding is used so the controls do not scroll into the top text and buttons. -->
		<VerticalStackLayout Grid.Row="2" Margin="0,0,20,0" Padding="0,0,20,0"
			IsVisible="{Binding ActiveInitializationPart, Converter={StaticResource PartView}, ConverterParameter={x:Static enums:InitializationPartType.Templates}}">

			<Picker
				Title="Entry Type"
				x:Name="_templatePicker"
				ItemsSource="{Binding TemplateNames}"
				SelectedItem="{Binding SelectedTemplate}">
				<Picker.Behaviors>
					<mct:EventToCommandBehavior
                    x:TypeArguments="system:EventArgs"
                    Command="{Binding SelectedTemplateChangedCommand}"
                    BindingContext="{Binding Path=BindingContext, Source={x:Reference __templatePicker}, x:DataType=Picker}"
                    EventName="SelectedIndexChanged"/>
				</Picker.Behaviors>
			</Picker>

		</VerticalStackLayout>

	</Grid>
</ContentPage>