<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

	<Style TargetType="Button" Class="SquareButtonStyle">
	</Style>

	<Style TargetType="Button" ApplyToDerivedTypes="True" x:Key="ToolBarButtonBaseStyle"  BasedOn="{StaticResource ButtonBaseStyle}">
		<Setter Property="WidthRequest" Value="40"/>
		<Setter Property="HeightRequest" Value="20"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="CornerRadius" Value="6"/>
	</Style>

	<Style TargetType="Button" Class="ToolBarButtonStyle" BasedOn="{StaticResource ToolBarButtonBaseStyle}">
	</Style>
	
	<Style TargetType="Button" Class="WideToolBarButtonStyle" BasedOn="{StaticResource ToolBarButtonBaseStyle}">
		<Setter Property="WidthRequest" Value="80"/>
	</Style>

	<Style TargetType="Border" Class="SmallTitleBorderStyle">
		<Setter Property="StrokeShape" Value="RoundRectangle 8"/>
		<Setter Property="StrokeThickness" Value="2"/>
		<Setter Property="Padding" Value="0,1,0,2"/>
		<Setter Property="Margin" Value="0,30,0,2"/>
		<Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource DivisionColor}, Dark={StaticResource DivisionColor}}"/>
	</Style>

	<Style TargetType="Label" Class="SmallTitleLabelStyle">
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontAttributes" Value="Bold"/>
		<Setter Property="HorizontalOptions" Value="Center"/>
		<Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DivisionColor}, Dark={StaticResource DivisionColor}}"/>
	</Style>


    <Style TargetType="Label" Class="MediumTitleLabelStyle">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="HorizontalOptions" Value="Start"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DivisionColor}, Dark={StaticResource DivisionColor}}"/>
    </Style>

	<Style TargetType="Grid" Class="SettingsTwoColumnGridStyle">
		<Setter Property="RowSpacing" Value="4"/>
		<Setter Property="ColumnSpacing" Value="25"/>
	</Style>

	<Style TargetType="RadioButton">
		<Setter Property="MinimumWidthRequest" Value="15"/>
	</Style>

	<ControlTemplate x:Key="ButtonRadioTemplate">
		<Border
            StrokeThickness="1"
            WidthRequest="{TemplateBinding Width}"
			x:DataType="RadioButton">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="0"/>
			</Border.StrokeShape>
			<VisualStateManager.VisualStateGroups>
				<VisualStateGroupList>
					<VisualStateGroup x:Name="CheckedStates">
						<VisualState x:Name="Checked">
							<VisualState.Setters>
								<Setter TargetName="TextLabel" Property="Label.TextColor" Value="{DynamicResource White}"/>
								<Setter Property="Background" Value="{DynamicResource SelectorSelectedColor}"/>
								<Setter Property="Stroke" Value="{DynamicResource SelectorSelectedColor}"/>
							</VisualState.Setters>
						</VisualState>

						<VisualState x:Name="Unchecked">
							<VisualState.Setters>
								<Setter TargetName="TextLabel" Property="Label.TextColor" Value="{DynamicResource Primary}"/>
								<Setter Property="Background" Value="{DynamicResource SelectorBackgroundColor}"/>
								<Setter Property="Stroke" Value="{DynamicResource SelectorBackgroundColor}"/>
							</VisualState.Setters>
						</VisualState>
					</VisualStateGroup>
				</VisualStateGroupList>
			</VisualStateManager.VisualStateGroups>

			<Label
				Text="{TemplateBinding Content}"
				Margin="0"
				x:Name="TextLabel"
				x:DataType="RadioButton"
				FontSize="{TemplateBinding FontSize}"
				FontAttributes="Bold" 
				HorizontalOptions="Fill"
				VerticalOptions="Center"
				HorizontalTextAlignment="Center"
				VerticalTextAlignment="Center"/>
		</Border>
	</ControlTemplate>

</ResourceDictionary>